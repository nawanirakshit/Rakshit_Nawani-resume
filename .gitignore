# LaTeX build byproducts (regenerated by xelatex/latexmk/biber)
*.aux
*.bcf
*.log
*.run.xml
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.toc
*.bbl-SAVE-ERROR
*.blg

# latexmk default output directory
%OUTDIR%/

# Build output (PDFs + byproducts land here — see readme.md)
# Keep the folder structure in git via .gitkeep, ignore everything else inside
build/resume/*
build/coverletter/*
!build/resume/.gitkeep
!build/coverletter/.gitkeep

# Any stray root-level generated PDFs (legacy builds)
/*.pdf
